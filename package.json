{
  "name": "local-code-mcp",
  "version": "0.1.0",
  "description": "只读本地代码 Model Context Protocol Server",
  "type": "module",
  "bin": { "local-code-mcp": "dist/cli.js" },
  "exports": "./dist/index.js",
  "files": ["dist", "README.md", "LICENSE", "SECURITY.md", "docs", "examples"],
  "engines": { "node": ">=20" },
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "smoke": "tsx scripts/smoke-test.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "ignore": "7.0.5",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.3.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.9.1",
    "tsx": "4.20.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.11"
  }
}
